# Copy to .env and adjust. NEVER commit a filled .env (secrets).
# Local defaults are safe for the dev machine only — see BACKEND.md §6.

# Nakama shared secret. Local default "defaultkey" is FINE here and MUST
# never ship to the VPS (deploy.sh generates a real one).
NAKAMA_SERVER_KEY=defaultkey

# Session token signing keys (must differ from each other; defaults are the
# Nakama built-in dev values — fine locally, generated on the VPS).
SESSION_ENCRYPTION_KEY=defaultencryptionkey
SESSION_REFRESH_ENCRYPTION_KEY=defaultrefreshencryptionkey

# Postgres password for the internal-only database container.
POSTGRES_PASSWORD=localdb
