# LOCAL development Caddyfile (plain HTTP — BACKEND.md §4).
# Host :8080 = api base URL  -> static /config/* + reverse proxy to Nakama
# Production Caddyfile is generated by deploy.sh (TLS on the api subdomain).

{
	admin off
}

:80 {
	handle /config/* {
		root * /srv/config
		header Content-Type application/json
		file_server
	}
	reverse_proxy nakama:7350
}
